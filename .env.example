# Copy to .env and fill in. All settings are optional.

# Open Plantbook API credentials (https://open.plantbook.io → API credentials)
# You can also set these in the UI (Settings → Integrations), which takes precedence.
PLANTASAURUS_OPB_CLIENT_ID=
PLANTASAURUS_OPB_CLIENT_SECRET=

# Home Assistant connection, for assigning irrigation zones and plant monitors to spots.
# You can also set this up in the UI (Settings → Integrations), which takes precedence.
# PLANTASAURUS_HA_URL=http://homeassistant.local:8123
# PLANTASAURUS_HA_TOKEN=
# PLANTASAURUS_HA_SYNC_INTERVAL_SECONDS=900

# Session signing key. If unset, one is generated and stored in the data volume.
# PLANTASAURUS_SECRET_KEY=

# Set to true when served over HTTPS so session cookies are marked Secure.
# PLANTASAURUS_COOKIE_SECURE=false

# Home Assistant ingress mode (used by the future add-on): trust X-Remote-User-* headers
# from the supervisor and skip the login screen.
# PLANTASAURUS_INGRESS_MODE=false

# MCP server at /mcp for AI assistants (authenticate with an API token). Admins can turn it
# on and off in Settings → Integrations; false removes it entirely and locks that switch.
# PLANTASAURUS_MCP_ENABLED=true
