{
  // Run (Ctrl+F5) or debug (F5) from the Run and Debug view.
  // "Full stack" starts the backend and the Vite dev server together; open http://localhost:5173.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.asgi:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PLANTASAURUS_DATA_DIR": "${workspaceFolder}/backend/data" },
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-x"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: Vite",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // VS Code's integrated browser; breakpoints in frontend/src work via Vite's source maps.
      "name": "Frontend: browser",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Backend: uvicorn", "Frontend: Vite", "Frontend: browser"],
      "stopAll": true
    }
  ]
}
